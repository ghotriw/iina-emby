{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"lineWidth": 140
	},
	"linter": {
		"rules": {
			"correctness": {
				"noUnknownPseudoClass": {
					"level": "warn",
					"options": {
						"ignore": ["global", "local"]
					}
				}
			}
		}
	}
}
